  <tcho rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tcho>
  <tp rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</tp>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Patient"/>
    <rdf:Description rdf:about="#Biopsy"/>
    <rdf:Description rdf:about="#Exam"/>
